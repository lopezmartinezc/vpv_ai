# Backend environment variables — copy to .env and fill in real values
#
# Database — use individual PG_* vars (password is auto-escaped for URLs)
PG_HOST=localhost
PG_PORT=5432
PG_USER=vpv
PG_PASSWORD=CHANGE_ME
PG_DATABASE=ligavpv

DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Auth
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_EXPIRE_MINUTES=480

# Invites
INVITE_BASE_URL=http://localhost:3000/registro
INVITE_EXPIRY_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Telegram (leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Draft assistant (admin-only chat in the live draft).
# NEVER copy these keys into a NEXT_PUBLIC_* var: that would bundle them into
# the browser JS and make them public. Set a spend cap on the provider console.
ASSISTANT_ENABLED=false
# anthropic | openai
ASSISTANT_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ASSISTANT_ANTHROPIC_MODEL=claude-opus-5
ASSISTANT_OPENAI_MODEL=gpt-5
# Send "Participante 3" instead of real names to the provider.
ASSISTANT_ANONYMIZE_PARTICIPANTS=true
# Vueltas de herramientas por pregunta. Una pregunta amplia encadena varias
# consultas; con menos de ~12 se corta justo antes de responder.
ASSISTANT_MAX_TOOL_ROUNDS=20
